# Weights & Biases
WANDB_API_KEY=your_wandb_key_here
WANDB_PROJECT=[[ package_name ]]
WANDB_ENTITY=[[ wandb_entity ]]

# Hugging Face
HF_TOKEN=your_hf_token_here
HF_HOME=./data/hf_cache

# Storage (local, s3, gcs)
STORAGE_BACKEND=[[ storage_backend ]]
STORAGE_ROOT=./results

# S3 (if STORAGE_BACKEND=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET=

# GCS (if STORAGE_BACKEND=gcs)
GOOGLE_APPLICATION_CREDENTIALS=
GCS_BUCKET=

# SLURM (if launcher=slurm)
SLURM_MODULES=
SLURM_ACCOUNT=
SLURM_PARTITION=
SLURM_QOS=
SLURM_TIME=01:00:00
SLURM_GPUS=1
SLURM_CPUS_PER_GPU=4
SLURM_MEM=16G

# EC2 (if launcher=ec2)
EC2_INSTANCE_ID=
EC2_LAUNCH_TEMPLATE=
EC2_KEY_NAME=
EC2_SSH_USER=ubuntu
EC2_REGION=us-east-1

# AWS Batch (if launcher=aws_batch)
BATCH_JOB_DEFINITION=
BATCH_JOB_QUEUE=
BATCH_REGION=us-east-1

# Ray (if launcher=ray)
RAY_CLUSTER_ADDRESS=
ANYSCALE_API_KEY=
